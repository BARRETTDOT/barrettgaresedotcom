---
// Shared listing page for a topic, place or series.
import Paper from '../layouts/Paper.astro';
import PostCard from './PostCard.astro';
import type { Post } from '../lib/sanity';

interface Props { kind: string; title: string; description?: string; posts: Post[] }
const { kind, title, description, posts } = Astro.props;
---
<Paper title={`${title} — Writing — Barrett Garese`} description={description ?? `${kind}: ${title}. Writing by Barrett Garese.`}>
  <main class="list">
    <header>
      <p class="kicker"><a href="/writing">Writing</a> · {kind}</p>
      <h1><em>{title}</em></h1>
      {description && <p class="desc">{description}</p>}
      <p class="meta">{posts.length} {posts.length === 1 ? 'piece' : 'pieces'}</p>
    </header>
    <div>{posts.map((p) => <PostCard post={p} />)}</div>
  </main>
</Paper>

<style>
  .list { max-width: 980px; margin: 0 auto; padding: 0 var(--gutter); }
  header { text-align: center; padding: clamp(56px, 10vh, 110px) 0 48px; }
  header .kicker { margin-bottom: 16px; }
  h1 { font-family: var(--display); font-weight: 300; font-size: clamp(48px, 7.5vw, 80px); line-height: 1.02; }
  .desc { font-size: 19px; line-height: 1.6; color: var(--ink-soft); max-width: 34em; margin: 18px auto 0; }
  header .meta { margin-top: 18px; }
</style>
