---
// Homepage: five equal-area sections around the spinning BARRETT. medallion.
// Styles and script are kept global/inline so they behave exactly like the original static page.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Barrett Garese</title>
  <meta name="description" content="Barrett Garese — FanSpark, EnjoyThis, The Evening Saga, and writing." />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --s1-bg: #0e0d0a; --s1-accent: #2aba6a;   /* FanSpark */
      --s2-bg: #0d0d0d; --s2-accent: #c8a96e;   /* EnjoyThis */
      --s3-bg: #0a0e1a; --s3-accent: #6e8fc8;   /* Evening */
      --s4-bg: #110c0d; --s4-accent: #c27a86;   /* Writing (new) */
      --s5-bg: #0d0d0d; --s5-accent: #b5742a;   /* Something New */
      --text-light: rgba(255,255,255,0.88);
      --text-dim: rgba(255,255,255,0.3);
      --center-size: 140px;
      --transition: 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }

    html, body { width: 100%; height: 100%; overflow: hidden; background: #0d0d0d; cursor: none; }
    @media (hover: none), (max-width: 768px) {
      html, body { cursor: auto; height: 100dvh; }
    }

    /* Custom cursor (unchanged) */
    .cursor { position: fixed; width: 10px; height: 10px; border-radius: 50%; background: #fff; pointer-events: none; z-index: 9999; transform: translate(-50%, -50%); transition: transform .1s ease, width .3s ease, height .3s ease, opacity .3s ease; mix-blend-mode: difference; }
    .cursor-ring { position: fixed; width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.4); pointer-events: none; z-index: 9998; transform: translate(-50%, -50%); transition: transform .18s ease, width .3s ease, height .3s ease, opacity .3s ease; }
    .cursor.hovering { width: 16px; height: 16px; }
    .cursor-ring.hovering { width: 56px; height: 56px; opacity: 0.6; }
    @media (hover: none), (max-width: 768px) { .cursor, .cursor-ring { display: none; } }

    .stage { position: relative; width: 100vw; height: 100vh; height: 100dvh; overflow: hidden; }

    /* Each sector is a full-stage layer clipped to its wedge; clip-path also clips hit-testing */
    .sector {
      position: absolute; inset: 0;
      display: block; text-decoration: none;
      background: var(--bg);
      transition: background var(--transition);
      animation: fadeIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .sector::before {
      content: ''; position: absolute; inset: 0; opacity: 0; pointer-events: none;
      transition: opacity var(--transition);
      background: radial-gradient(circle at var(--gx) var(--gy), var(--accent) 0%, transparent 45%);
    }
    .sector:hover::before { opacity: 0.12; }
    .sector::after {
      content: ''; position: absolute; inset: 0; opacity: 0.6; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    }

    .s1 { --bg: var(--s1-bg); --accent: var(--s1-accent); animation-delay: .05s; }
    .s2 { --bg: var(--s2-bg); --accent: var(--s2-accent); animation-delay: .12s; }
    .s3 { --bg: var(--s3-bg); --accent: var(--s3-accent); animation-delay: .19s; }
    .s4 { --bg: var(--s4-bg); --accent: var(--s4-accent); animation-delay: .26s; }
    .s5 { --bg: var(--s5-bg); --accent: var(--s5-accent); animation-delay: .33s; }

    /* Content sits at each wedge's centroid (set by JS) */
    .s-content {
      position: absolute; left: var(--ax); top: var(--ay);
      transform: translate(-50%, -50%);
      display: flex; flex-direction: column; align-items: center; text-align: center;
      width: max-content; max-width: min(34vw, 420px);
    }

    .q-label {
      font-family: 'DM Sans', sans-serif; font-weight: 300; font-size: 12px;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-dim);
      margin-bottom: 14px; transition: color var(--transition);
    }
    .q-title {
      font-family: 'Cormorant Garamond', serif; font-weight: 300;
      font-size: clamp(28px, 3.2vw, 48px); line-height: 1.1; color: var(--text-light);
      letter-spacing: -0.01em; transition: color var(--transition);
    }
    .q-title em { font-style: italic; font-weight: 300; }
    .sector:hover .q-label { color: var(--accent); }
    .sector:hover .q-title { color: #fff; }

    .q-arrow {
      width: 22px; height: 22px; margin-top: 18px; opacity: 0;
      transform: translate(-6px, 6px); transition: opacity var(--transition), transform var(--transition);
    }
    .q-arrow svg { width: 100%; height: 100%; }
    .sector:hover .q-arrow { opacity: 0.5; transform: translate(0,0); }


    /* Coming Soon treatment */
    .s5 .q-title { color: rgba(255,255,255,0.22); font-style: italic; }
    .s5:hover .q-title { color: rgba(255,255,255,0.38); }
    .s5 { cursor: default; }

    /* Spokes */
    .spokes { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; }
    .spokes line { stroke: rgba(255,255,255,0.07); stroke-width: 1; }

    /* Center (unchanged, plus five fixed ticks echoing the sections) */
    .center {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      z-index: 10; width: var(--center-size); height: var(--center-size);
      display: flex; align-items: center; justify-content: center;
      animation: fadeIn 1.1s ease .3s both;
    }
    .center-inner {
      width: 100%; height: 100%; border-radius: 50%; background: #0d0d0d;
      border: 1px solid rgba(255,255,255,0.1);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      position: relative; text-decoration: none;
    }
    .center-ring {
      position: absolute; inset: -8px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.04); animation: spin 24s linear infinite;
    }
    .center-ring::before {
      content: ''; position: absolute; top: -1px; left: 50%; transform: translateX(-50%);
      width: 4px; height: 4px; border-radius: 50%; background: rgba(255,255,255,0.3);
    }
    .center-first {
      font-family: 'Cormorant Garamond', serif; font-size: 11px; font-weight: 300;
      letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.55); line-height: 1;
    }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    @media (hover: none), (max-width: 768px) {
      :root { --center-size: 80px; }
      .q-label { font-size: 8px; letter-spacing: 0.14em; margin-bottom: 8px; }
      .q-title { font-size: clamp(20px, 6vw, 30px); }
      .s-content { max-width: 36vw; }
      .q-label { line-height: 1.5; }
      .q-arrow { opacity: 0.3; transform: none; width: 14px; height: 14px; margin-top: 10px; }
    }
  </style>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>

<div class="stage" id="stage">

  <a class="sector s1" href="https://fanspark.pro" target="_blank" rel="noopener">
    <div class="s-content">
      <div class="q-label">Sports &amp; Creator Economy</div>
      <div class="q-title"><em>FanSpark.pro</em></div>
      <div class="q-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.2"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg></div>
    </div>
  </a>

  <a class="sector s2" href="https://www.enjoythis.app/" target="_blank" rel="noopener">
    <div class="s-content">
      <div class="q-label">Your "I thought you'd love this" inbox</div>
      <div class="q-title"><em>EnjoyThis</em></div>
      <div class="q-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.2"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg></div>
    </div>
  </a>

  <a class="sector s3" href="https://theeveningsaga.com" target="_blank" rel="noopener">
    <div class="s-content">
      <div class="q-label">Ongoing Science Fiction</div>
      <div class="q-title"><em>The Evening<br>Saga</em></div>
      <div class="q-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.2"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg></div>
    </div>
  </a>

  <a class="sector s4" href="/writing">
    <div class="s-content">
      <div class="q-label">Essays, Travel &amp; Dispatches</div>
      <div class="q-title"><em>Writing</em></div>
      <div class="q-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
    </div>
  </a>

  <div class="sector s5">
    <div class="s-content">
      <div class="q-label">Coming Soon</div>
      <div class="q-title"><em>Something<br>New</em></div>
    </div>
  </div>

  <svg class="spokes" id="spokes"></svg>

  <div class="center">
    <a class="center-inner" href="https://www.linkedin.com/in/barrettgarese/" target="_blank" rel="noopener">
      <div class="center-ring"></div>
      <span class="center-first">BARRETT.</span>
    </a>
  </div>
</div>

<script is:inline>
  /* ---------- Five equal-area wedges around the center ----------
     Walk the viewport's perimeter clockwise from top-center. The triangle swept
     from the center to a perimeter segment has area 0.5 × (distance to that edge)
     × (segment length), so equal-area wedges = equal "weighted" perimeter steps.
     Works at any aspect ratio: desktop, portrait phone, ultrawide. */
  const N = 5;
  const stage = document.getElementById('stage');
  const spokes = document.getElementById('spokes');
  const sectors = [...stage.querySelectorAll('.sector')];

  function layout() {
    const W = stage.clientWidth, H = stage.clientHeight, cx = W / 2, cy = H / 2;
    // perimeter segments clockwise from top-center: [x0,y0,x1,y1, distanceFromCenterToEdge]
    const segs = [
      [cx, 0, W, 0, cy], [W, 0, W, H, cx], [W, H, 0, H, cy], [0, H, 0, 0, cx], [0, 0, cx, 0, cy]
    ].map(([x0,y0,x1,y1,d]) => ({ x0,y0,x1,y1, len: Math.hypot(x1-x0, y1-y0), dens: d / 2 }));

    // point at cumulative area a (0..W*H), plus the corners passed on the way
    function walk(aStart, aEnd) {
      const pts = []; let acc = 0;
      for (const s of segs) {
        const segArea = s.len * s.dens, a0 = acc, a1 = acc + segArea;
        const at = a => { const t = (a - a0) / segArea; return [s.x0 + (s.x1 - s.x0) * t, s.y0 + (s.y1 - s.y0) * t]; };
        if (aStart >= a0 && aStart <= a1 && !pts.length) pts.push(at(aStart));
        if (pts.length && aEnd > a1 + 1e-6) pts.push([s.x1, s.y1]);
        if (aEnd >= a0 && aEnd <= a1 + 1e-6 && pts.length) { pts.push(at(Math.min(aEnd, a1))); break; }
        acc = a1;
      }
      return pts;
    }

    const total = W * H, step = total / N;
    let lines = '';
    sectors.forEach((el, i) => {
      // reading order: section 1 is the upper-left wedge (ending at the top-center spoke), then clockwise
      const slot = (i + N - 1) % N;
      const edge = walk(slot * step, (slot + 1) * step);
      const poly = [[cx, cy], ...edge];
      el.style.clipPath = 'polygon(' + poly.map(([x, y]) => `${x}px ${y}px`).join(',') + ')';

      // centroid (shoelace)
      let A = 0, Cx = 0, Cy = 0;
      for (let k = 0; k < poly.length; k++) {
        const [x0, y0] = poly[k], [x1, y1] = poly[(k + 1) % poly.length];
        const c = x0 * y1 - x1 * y0; A += c; Cx += (x0 + x1) * c; Cy += (y0 + y1) * c;
      }
      A /= 2; Cx /= 6 * A; Cy /= 6 * A;
      // push content slightly outward so it clears the center medallion
      const box = el.querySelector('.s-content');
      const bw = box.offsetWidth / 2 + 18, bh = box.offsetHeight / 2 + 18;
      const clamp = (v, lo, hi) => Math.min(Math.max(v, lo), hi);
      const push = W < H ? 1.3 : 1.12; // portrait: pull text further toward the outer edge, away from neighbouring spokes
      const ax = clamp(cx + (Cx - cx) * push, bw, W - bw), ay = clamp(cy + (Cy - cy) * push, bh, H - bh);
      el.style.setProperty('--ax', ax + 'px'); el.style.setProperty('--ay', ay + 'px');
      el.style.setProperty('--gx', ax + 'px'); el.style.setProperty('--gy', ay + 'px');

      const [sx, sy] = edge[0];
      lines += `<line x1="${cx}" y1="${cy}" x2="${sx}" y2="${sy}"/>`;
    });
    spokes.setAttribute('viewBox', `0 0 ${W} ${H}`);
    spokes.innerHTML = lines;
  }
  layout();
  addEventListener('resize', layout);

  /* ---------- Custom cursor (unchanged) ---------- */
  const cursor = document.getElementById('cursor'), ring = document.getElementById('cursorRing');
  let mx = 0, my = 0, rx = 0, ry = 0;
  document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; cursor.style.left = mx + 'px'; cursor.style.top = my + 'px'; });
  (function animRing() { rx += (mx - rx) * 0.12; ry += (my - ry) * 0.12; ring.style.left = rx + 'px'; ring.style.top = ry + 'px'; requestAnimationFrame(animRing); })();
  document.querySelectorAll('a.sector').forEach(el => {
    el.addEventListener('mouseenter', () => { cursor.classList.add('hovering'); ring.classList.add('hovering'); });
    el.addEventListener('mouseleave', () => { cursor.classList.remove('hovering'); ring.classList.remove('hovering'); });
  });
</script>
</body>
</html>
